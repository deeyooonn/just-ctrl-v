generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ---------- NextAuth required models ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App-specific models ----------

enum PlanTier {
  FREE
  PLUS
  PRO
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed — only set for email/password accounts

  accounts Account[]
  sessions Session[]

  // --- Plan / subscription ---
  planTier      PlanTier  @default(FREE)
  planExpiresAt DateTime? // null = no active paid plan (or plan already lapsed)
  lemonSqueezyCustomerId     String?   @unique
  lemonSqueezySubscriptionId String?   @unique

  // --- Daily usage tracking (fixed caps, do not accumulate) ---
  dailyImagesUsed Int      @default(0) // resets to 0 each new day
  dailyFilesUsed  Int      @default(0) // resets to 0 each new day
  usageResetAt    DateTime @default(now()) // last time the daily counters were reset

  // --- Preferences ---
  autoSaveEnabled Boolean  @default(true)

  conversions Conversion[]
  folders     Folder[]

  createdAt DateTime @default(now())
}

enum ConversionMode {
  FLASHCARDS
  EXCEL
  WORD
}

enum ConversionSourceType {
  IMAGE
  FILE
}

model Conversion {
  id         String               @id @default(cuid())
  userId     String
  mode       ConversionMode
  sourceType ConversionSourceType

  // Store the extracted result as JSON so it works for all three modes
  // (flashcard array, {headers, rows}, or {sections})
  resultJson Json

  title     String? // optional user-given or auto-generated title for history list
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Folder {
  id              String         @id @default(cuid())
  userId          String
  name            String
  mode            ConversionMode // Defines if folder holds FLASHCARDS or EXCEL (Tables)
  
  // The aggregated content (array of flashcards or array of table rows)
  contentJson     Json           @default("[]")
  
  // Stores the state of contentJson *before* the last merge, enabling 1-step Undo
  previousContent Json?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
